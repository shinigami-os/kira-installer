import { Palette } from "palette.slint";
import { WelcomePage } from "pages/welcome.slint";

export component AppWindow inherits Window {
    title: "Kira Installer";
    background: Palette.base;
    // deliberately no explicit width/height - the content still rendered centered-but-small
    // in the corner of the real 1920x1080 panel with 1280x720 declared here (confirmed live
    // on kira2 via two screenshots), meaning Slint was laying everything out correctly inside
    // that smaller logical canvas and the LinuxKMS backend was NOT overriding it with the
    // real display's size - leaving this unset lets it pick up the actual DRM mode instead

    callback continue-pressed <=> welcome.continue-pressed;
    callback quit-requested <=> welcome.quit-requested;

    welcome := WelcomePage {}
}
