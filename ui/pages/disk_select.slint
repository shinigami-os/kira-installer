import { Palette } from "../palette.slint";

export struct DiskEntry {
    short-name: string,
    label: string,
    is-live: bool,
}

export component DiskSelectPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Palette.base;

    in property <[DiskEntry]> entries;
    in property <int> selected;

    callback selection-changed(int);
    callback continue-pressed();
    callback back-pressed();

    init => { key-handler.focus(); }

    key-handler := FocusScope {
        key-pressed(event) => {
            if ((event.text == Key.UpArrow || event.text == "k") && selected > 0) {
                selection-changed(selected - 1);
                return accept;
            }
            if ((event.text == Key.DownArrow || event.text == "j") && selected + 1 < entries.length) {
                selection-changed(selected + 1);
                return accept;
            }
            if (event.text == Key.Return && entries.length > 0) {
                continue-pressed();
                return accept;
            }
            if (event.text == Key.Escape) {
                back-pressed();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 24px;

        Text {
            text: "Select Install Disk";
            color: Palette.primary;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            if entries.length == 0 : Text {
                text: "no disks found";
                color: Palette.subtext;
                horizontal-alignment: center;
            }

            for entry[i] in entries : VerticalLayout {
                alignment: center;
                Text {
                    text: (i == selected ? "> " : "  ") + entry.label;
                    color: i == selected ? Palette.primary : Palette.text;
                    font-weight: i == selected ? 700 : 400;
                    horizontal-alignment: center;
                }
                if entry.is-live : Text {
                    text: "    (appears to be the live/installer medium itself)";
                    color: Palette.secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }

        Text {
            text: "Up/Down to select  -  Enter to continue  -  Esc to go back";
            color: Palette.subtext;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}
