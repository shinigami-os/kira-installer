#!/bin/sh
# The live medium is this and nothing else: the installer inside cage on tty1, no login, no shell.
# cage without -s does not let a VT switch through, and runit starts it again if it ever exits.
exec 2>&1

i=0
while [ ! -S /run/seatd.sock ] && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
done

i=0
while [ ! -e /dev/dri/card0 ] && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
done

export XDG_RUNTIME_DIR=/run/kira-installer
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# one output only: the default stretches a window across every screen
exec cage -d -m last -- /usr/share/kira-installer/launch.sh
