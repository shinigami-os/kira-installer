import { Palette } from "../palette.slint";

export component WelcomePage inherits Rectangle {
    // without an explicit size this Rectangle only grows to fit its own content (the logo +
    // text) rather than filling the real display - found live on kira2: the LinuxKMS backend
    // sizes the Window itself from the actual DRM mode (1920x1080 there) regardless of any
    // width/height declared on the Window, but a plain child element doesn't inherit that
    // size automatically, so it rendered small and pinned to a corner instead of centered.
    width: 100%;
    height: 100%;
    background: Palette.base;

    callback continue-pressed();
    callback quit-requested();

    // the LinuxKMS backend has no window manager to hand this window focus on our behalf -
    // claim it ourselves as soon as this page exists, or no key press would ever reach it
    init => { key-handler.focus(); }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return) {
                continue-pressed();
                return accept;
            }
            if (event.text == "q" || event.text == "Q" || event.text == Key.Escape) {
                quit-requested();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // a layout element doesn't fill its parent by default either - without this it sizes
        // to its own content (the logo + text block) and sits near the top-left corner of the
        // real display instead of being centered on it, same root cause as the Rectangle fix
        // above, found in the same live screenshot
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 24px;

        Image {
            source: @image-url("../../assets/kira-logo.png");
            height: 160px;
            image-fit: contain;
        }

        Text {
            text: "Kira Linux";
            color: Palette.primary;
            font-size: 32px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "a rolling-release, musl libc Linux distribution";
            color: Palette.subtext;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Text {
            text: "Press Enter to begin  -  Q to quit";
            color: Palette.subtext;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}
